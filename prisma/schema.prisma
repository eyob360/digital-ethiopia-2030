generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OPERATOR
  VIEWER
}

enum PipelineLockName {
  INGESTION
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(VIEWER)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model KpiDefinition {
  id                 String           @id @default(cuid())
  name               String           @unique
  description        String
  expectedUnit       String           @map("expected_unit")
  targetValue        Decimal?         @map("target_value") @db.Decimal(18, 4)
  category           String
  sourceUrls         String[]         @default([]) @map("source_urls")
  fetchIntervalHours Int              @default(24) @map("fetch_interval_hours")
  observations       KpiObservation[]
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@map("kpi_definitions")
}

model RawDocument {
  id           String           @id @default(cuid())
  sourceUrl    String           @map("source_url")
  rawText      String           @map("raw_text")
  contentHash  String           @unique @map("content_hash")
  observations KpiObservation[]
  createdAt    DateTime         @default(now()) @map("created_at")

  @@map("raw_documents")
}

model KpiObservation {
  id            String        @id @default(cuid())
  kpiId         String        @map("kpi_id")
  rawDocumentId String?       @map("raw_document_id")
  value         Decimal       @db.Decimal(18, 4)
  unit          String
  region        String
  observedDate  DateTime      @map("observed_date") @db.Date
  sourceUrl     String        @map("source_url")
  aiConfidence  Decimal       @map("ai_confidence") @db.Decimal(4, 3)
  reviewFlag    Boolean       @default(false) @map("review_flag")
  explanation   String?
  kpi           KpiDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  rawDocument   RawDocument?  @relation(fields: [rawDocumentId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([kpiId, createdAt])
  @@map("kpi_observations")
}

model UrlFilterConfig {
  id             String   @id @default("default")
  blockedDomains String[] @default([]) @map("blocked_domains")
  allowedDomains String[] @default([]) @map("allowed_domains")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("url_filter_configs")
}

model PipelineLock {
  name                PipelineLockName @id
  locked              Boolean          @default(false)
  lockedAt            DateTime?        @map("locked_at")
  runId               String?          @map("run_id")
  branchesTotal       Int              @default(0) @map("branches_total")
  branchesCompleted   Int              @default(0) @map("branches_completed")
  completedBranchKeys String[]         @default([]) @map("completed_branch_keys")
  documentsProcessed  Int              @default(0) @map("documents_processed")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@map("pipeline_locks")
}
