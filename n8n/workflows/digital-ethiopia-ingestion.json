      "parameters": {
        "jsCode": "const context = $('Store Raw Document').item.json;\nconst text = $json.output_text ?? $json.choices?.[0]?.message?.content ?? '';\nlet parsed;\ntry { parsed = typeof text === 'string' ? JSON.parse(text) : text; } catch { return [{ json: { ...context, terminalReason: 'invalid-relevance-json' } }]; }\nif (typeof parsed?.relevant !== 'boolean' || typeof parsed?.confidence !== 'number') return [{ json: { ...context, terminalReason: 'invalid-relevance-json' } }];\nreturn [{ json: { ...context, relevance: parsed } }];"
      },
