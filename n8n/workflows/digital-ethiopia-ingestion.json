      "parameters": {
        "jsCode": "const context = $('Store Raw Document').item.json;\nconst text = $json.output_text ?? $json.choices?.[0]?.message?.content ?? '';\nlet parsed;\ntry { parsed = typeof text === 'string' ? JSON.parse(text) : text; } catch { return [{ json: { ...context, terminalReason: 'invalid-extraction-json' } }]; }\nconst required = ['value_numeric', 'unit', 'region', 'observed_date', 'explanation', 'confidence'];\nif (!required.every((key) => Object.prototype.hasOwnProperty.call(parsed, key))) return [{ json: { ...context, terminalReason: 'invalid-extraction-json' } }];\nreturn [{ json: { runId: context.runId, branchKey: context.branchKey, kpiId: context.kpi.id, rawDocumentId: context.rawDocument.id, value: parsed.value_numeric, unit: parsed.unit, region: parsed.region, observedDate: parsed.observed_date, sourceUrl: context.rawDocument.sourceUrl, aiConfidence: parsed.confidence, explanation: parsed.explanation, fallbackUsed: context.fallbackUsed, sourceType: context.sourceType, candidateUrls: context.candidateUrls, priorityIndex: context.priorityIndex } }];"
