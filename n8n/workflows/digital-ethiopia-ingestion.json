        "jsonBody": "={\"model\":\"gpt-5-mini\",\"input\":[{\"role\":\"system\",\"content\":\"Return strict JSON only with keys: value_numeric, unit, region, observed_date, explanation, confidence. Do not normalize units, dates, percentages, currencies, or confidence thresholds.\"},{\"role\":\"user\",\"content\":\"KPI: \" + $json.kpi.name + \"\\nExpected unit: \" + $json.kpi.expectedUnit + \"\\nDocument: \" + $json.rawDocument.rawText.slice(0, 12000)}]}"
