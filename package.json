{
  "name": "digital-ethiopia-2030",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check README.md \"src/**/*.{ts,tsx,css}\" \"prisma/**/*.{js,ts,mjs}\" \"*.{js,ts,mjs,json,yml}\"",
    "format:write": "prettier --write README.md \"src/**/*.{ts,tsx,css}\" \"prisma/**/*.{js,ts,mjs}\" \"*.{js,ts,mjs,json,yml}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "next": "16.3.0",
    "next-auth": "4.24.15",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
